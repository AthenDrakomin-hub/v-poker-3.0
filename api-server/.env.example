# ============================================
# V-POKER API Server 环境变量
# ============================================

# 服务端口
PORT=3001

# PostgreSQL 数据库连接串（必须）
DATABASE_URL=postgresql://user:password@localhost:5432/vpoker

# 会话签名密钥（必须，生产环境请用随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret

# Bcrypt 哈希轮数（可选，默认 10）
BCRYPT_ROUNDS=10

# CORS 允许的源（逗号分隔，留空则允许所有）
# 示例：https://poker.example.com,https://admin.example.com
CORS_ORIGIN=
