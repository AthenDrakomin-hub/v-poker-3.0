# PostgreSQL 连接串（必填）
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 会话签名密钥（生产环境必填，用于签发登录令牌与哈希密码）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 一旦确定请勿更换，更换后所有账号密码将失效
SESSION_SECRET=

# bcrypt 哈希轮数（生产建议 10-12，开发可设为 8 加速）
BCRYPT_ROUNDS=10

# 数据库连接池上限（默认 30）
DB_POOL_MAX=30

# 日志轮转大小（字节，超出自动切割，默认 10MB）
# AUDIT_LOG_MAX_SIZE=10485760

# CORS 允许的前端来源（逗号分隔，生产环境必填）
# 示例：https://yourdomain.com,https://h5.yourdomain.com
CORS_ORIGIN=

# APP 自定义来源（可选，用于 uni-app 打包后的 WebView 来源）
# APP_ORIGINS=

# 服务端口（默认 3001）
PORT=3001
