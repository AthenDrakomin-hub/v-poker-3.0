{
  "openapi": "3.0.3",
  "info": {
    "title": "V-Poker 2.0 API",
    "description": "V-Poker 扑克游戏全栈项目后端API文档。V3经济模型：单一货币（筹码），多级代理返佣，抽水3%。",
    "version": "3.0.0",
    "contact": {
      "name": "V-Poker Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "开发环境"
    },
    {
      "url": "https://api.yourdomain.com",
      "description": "生产环境"
    }
  ],
  "tags": [
    { "name": "认证", "description": "用户登录、注册、登出、当前用户信息" },
    { "name": "房间", "description": "房间创建、加入、游戏操作、聊天" },
    { "name": "管理后台", "description": "管理员用户管理、统计、配置、客服操作" },
    { "name": "代理", "description": "代理玩家管理、推广、筹码调整、层级返佣" },
    { "name": "个人资料", "description": "用户资料修改、设备管理、密码修改" },
    { "name": "经济模型", "description": "游戏经济配置V2、模板管理、抽水配置" },
    { "name": "游戏规则", "description": "各游戏规则查询" },
    { "name": "素材", "description": "素材下载、资源管理" },
    { "name": "应用", "description": "版本信息、错误上报、经济费率" },
    { "name": "杂项", "description": "健康检查、APP下载、数据种子、历史清理" }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "基于Cookie的会话认证，登录后自动设置"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "错误信息" }
        },
        "required": ["error"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "account": { "type": "string" },
          "nickname": { "type": "string" },
          "role": { "type": "string", "enum": ["player", "agent", "top_agent", "admin", "customer_service"] },
          "points": { "type": "integer", "description": "筹码余额（V3单一货币）" },
          "invitedById": { "type": "integer", "description": "邀请人ID" },
          "createdAt": { "type": "string", "format": "date-time" },
          "lastLoginAt": { "type": "string", "format": "date-time" }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "gameType": { "type": "string", "enum": ["niuniu", "sangong", "tbnn", "jinhua", "texas"] },
          "name": { "type": "string" },
          "maxSeats": { "type": "integer" },
          "baseBet": { "type": "integer" },
          "level": { "type": "string", "enum": ["basic", "advanced", "premium"] },
          "pointsReq": { "type": "integer", "description": "开房筹码门槛（只校验不扣费）" },
          "currentRound": { "type": "integer" },
          "totalRounds": { "type": "integer" },
          "status": { "type": "string", "enum": ["waiting", "playing", "finished"] },
          "createdById": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Hand": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "roomId": { "type": "integer" },
          "roundNo": { "type": "integer" },
          "phase": { "type": "string" },
          "turnUserId": { "type": "integer" },
          "pot": { "type": "integer" },
          "finished": { "type": "boolean" },
          "seats": { "type": "array", "items": { "$ref": "#/components/schemas/HandSeat" } },
          "result": { "$ref": "#/components/schemas/HandResult" }
        }
      },
      "HandSeat": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer" },
          "seat": { "type": "integer" },
          "cards": { "type": "array", "items": { "type": "string" } },
          "totalBet": { "type": "integer" },
          "folded": { "type": "boolean" },
          "allIn": { "type": "boolean" },
          "acted": { "type": "boolean" },
          "autoPlay": { "type": "boolean" }
        }
      },
      "HandResult": {
        "type": "object",
        "properties": {
          "winnerUserId": { "type": "integer" },
          "winnerSeat": { "type": "integer" },
          "handName": { "type": "string" },
          "payouts": { "type": "array", "items": { "type": "object" } },
          "rake": { "type": "integer", "description": "抽水总额（3%）" },
          "agentRebates": { "type": "object", "description": "各级代理返佣分配" }
        }
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "roomId": { "type": "integer" },
          "userId": { "type": "integer" },
          "account": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "LedgerEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "type": { "type": "string", "enum": ["bet", "win", "rake", "adjust", "gift", "join", "leave"] },
          "amount": { "type": "integer" },
          "balanceAfter": { "type": "integer" },
          "referenceId": { "type": "string" },
          "remark": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [{ "cookieAuth": [] }],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "description": "账号密码登录，支持账号或昵称登录。登录成功后设置Session Cookie。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account", "password"],
                "properties": {
                  "account": { "type": "string", "description": "账号或昵称" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "account": { "type": "string" },
                    "role": { "type": "string" },
                    "mustChangePassword": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "description": "参数错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "账号或密码错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["认证"],
        "summary": "用户注册",
        "description": "新用户注册，支持邀请码关联代理。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account", "password"],
                "properties": {
                  "account": { "type": "string" },
                  "password": { "type": "string" },
                  "nickname": { "type": "string" },
                  "inviteCode": { "type": "string", "description": "邀请码（代理账号）" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "注册成功" },
          "400": { "description": "参数错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "账号已存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登出",
        "description": "清除Session Cookie，退出登录。",
        "responses": {
          "200": { "description": "登出成功" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["认证"],
        "summary": "获取当前用户信息",
        "description": "返回当前登录用户的完整信息，包括角色、筹码、代理层级等。",
        "responses": {
          "200": {
            "description": "用户信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/rooms/templates/{gameType}": {
      "get": {
        "tags": ["房间"],
        "summary": "获取房间模板",
        "description": "获取指定游戏类型的房间配置模板（底注、座位数、局数等）。",
        "security": [],
        "parameters": [
          { "name": "gameType", "in": "path", "required": true, "schema": { "type": "string", "enum": ["niuniu", "sangong", "tbnn", "jinhua", "texas"] } }
        ],
        "responses": {
          "200": { "description": "模板列表" }
        }
      }
    },
    "/api/rooms/create": {
      "post": {
        "tags": ["房间"],
        "summary": "创建房间",
        "description": "创建新游戏房间。需要代理或管理员权限，开房需满足筹码门槛（只校验不扣费）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["gameType", "name", "maxSeats", "baseBet", "totalRounds"],
                "properties": {
                  "gameType": { "type": "string" },
                  "name": { "type": "string" },
                  "maxSeats": { "type": "integer" },
                  "baseBet": { "type": "integer" },
                  "totalRounds": { "type": "integer" },
                  "level": { "type": "string", "enum": ["basic", "advanced", "premium"] },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "房间创建成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Room" } } } },
          "400": { "description": "参数错误" },
          "403": { "description": "无权限创建房间" },
          "402": { "description": "筹码不足，未达到开房门槛" }
        }
      }
    },
    "/api/rooms/join": {
      "post": {
        "tags": ["房间"],
        "summary": "加入房间",
        "description": "加入指定房间，可选择入座或观战。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["roomId"],
                "properties": {
                  "roomId": { "type": "integer" },
                  "password": { "type": "string" },
                  "seat": { "type": "integer", "description": "指定座位号，不传则自动分配" },
                  "spectate": { "type": "boolean", "description": "是否仅观战" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "加入成功" },
          "400": { "description": "参数错误" },
          "404": { "description": "房间不存在" },
          "409": { "description": "房间已满或已在房间中" }
        }
      }
    },
    "/api/rooms/mine": {
      "get": {
        "tags": ["房间"],
        "summary": "我创建的房间",
        "description": "获取当前用户创建的房间列表。",
        "responses": {
          "200": { "description": "房间列表", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Room" } } } } }
        }
      }
    },
    "/api/rooms/joined": {
      "get": {
        "tags": ["房间"],
        "summary": "我加入的房间",
        "description": "获取当前用户加入过的房间列表。",
        "responses": {
          "200": { "description": "房间列表" }
        }
      }
    },
    "/api/rooms/history": {
      "get": {
        "tags": ["房间"],
        "summary": "房间历史记录",
        "description": "获取已结束的房间历史记录，支持分页。",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "gameType", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "历史记录列表" }
        }
      }
    },
    "/api/rooms/{id}": {
      "get": {
        "tags": ["房间"],
        "summary": "获取房间详情",
        "description": "获取房间完整信息，包括当前牌局、座位状态、玩家列表。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "房间详情", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Room" } } } },
          "404": { "description": "房间不存在" }
        }
      }
    },
    "/api/rooms/{id}/ready": {
      "post": {
        "tags": ["房间"],
        "summary": "准备",
        "description": "玩家准备开始游戏。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "准备成功" },
          "400": { "description": "当前阶段无法准备" }
        }
      },
      "delete": {
        "tags": ["房间"],
        "summary": "取消准备",
        "description": "玩家取消准备。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "取消准备成功" }
        }
      }
    },
    "/api/rooms/{id}/auto-play": {
      "post": {
        "tags": ["房间"],
        "summary": "切换自动挂机",
        "description": "开启或关闭自动挂机模式。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "autoPlay": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "切换成功" }
        }
      }
    },
    "/api/rooms/{id}/spectate": {
      "post": {
        "tags": ["房间"],
        "summary": "切换观战/入座",
        "description": "在观战和入座之间切换。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "切换成功" }
        }
      }
    },
    "/api/rooms/{id}/chat": {
      "get": {
        "tags": ["房间"],
        "summary": "获取聊天记录",
        "description": "获取房间聊天消息列表，支持轮询。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "since", "in": "query", "schema": { "type": "integer", "description": "返回此ID之后的消息" } }
        ],
        "responses": {
          "200": { "description": "聊天消息列表", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ChatMessage" } } } } }
        }
      },
      "post": {
        "tags": ["房间"],
        "summary": "发送聊天消息",
        "description": "在房间中发送聊天消息。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "maxLength": 200 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "发送成功" },
          "400": { "description": "消息内容为空或过长" }
        }
      }
    },
    "/api/rooms/{id}/hand": {
      "get": {
        "tags": ["房间"],
        "summary": "获取当前牌局",
        "description": "获取当前牌局的完整状态，包括阶段、轮到谁、底池、各座位手牌（自己的可见）。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "牌局状态", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hand" } } } }
        }
      },
      "post": {
        "tags": ["房间"],
        "summary": "开始新一局",
        "description": "房主开始新一局游戏。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "开始成功" },
          "403": { "description": "无权限（非房主）" },
          "400": { "description": "玩家未全部准备" }
        }
      },
      "put": {
        "tags": ["房间"],
        "summary": "执行游戏操作",
        "description": "在当前牌局中执行操作（跟注、加注、弃牌、比牌、看牌等）。所有核心算法在服务端执行。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "type": "string", "enum": ["call", "raise", "fold", "check", "bet", "allin", "compare", "look", "confirm", "roll"] },
                  "amount": { "type": "integer", "description": "加注金额（raise/bet时需要）" },
                  "targetUserId": { "type": "integer", "description": "比牌目标用户ID（compare时需要）" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "操作成功" },
          "400": { "description": "无效操作或参数错误" },
          "403": { "description": "不是轮到你操作" }
        }
      }
    },
    "/api/rooms/{id}/ready_next": {
      "post": {
        "tags": ["房间"],
        "summary": "准备下一局",
        "description": "一局结束后准备下一局。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "准备成功" }
        }
      }
    },
    "/api/rooms/{id}/gift": {
      "post": {
        "tags": ["房间"],
        "summary": "赠送礼物",
        "description": "向其他玩家赠送礼物（消耗筹码）。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["targetUserId", "giftType"],
                "properties": {
                  "targetUserId": { "type": "integer" },
                  "giftType": { "type": "string" },
                  "amount": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "赠送成功" }
        }
      }
    },
    "/api/rooms/{id}/chip-transactions": {
      "get": {
        "tags": ["房间"],
        "summary": "房间筹码流水",
        "description": "获取房间内的筹码变动记录。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "流水列表", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LedgerEntry" } } } } }
        }
      }
    },
    "/api/rooms/{id}/early-settle": {
      "post": {
        "tags": ["房间"],
        "summary": "提前结算",
        "description": "房主提前结束当前牌局并结算。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "结算成功" },
          "403": { "description": "无权限" }
        }
      }
    },
    "/api/rooms/{id}/kick": {
      "post": {
        "tags": ["房间"],
        "summary": "踢出玩家",
        "description": "房主将玩家踢出房间，退还剩余筹码。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
